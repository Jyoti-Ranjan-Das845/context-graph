# The keys each tool needs, for reference. You don't need to copy this file:
# the Setup page (`cg setup`) saves keys to ~/.context-graph/.env, readable only by you.
# What to sync (repos, projects, channels, dates) lives in ~/.context-graph/settings.json.

# GitHub: fine-grained token, read-only (contents, issues, pull requests, metadata)
GITHUB_TOKEN=

# Linear: Settings > Security & access > Personal API keys
LINEAR_API_KEY=

# Jira: site, account email, and a token from id.atlassian.com > Security > API tokens
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Notion: internal connection token (share pages with the connection)
NOTION_TOKEN=

# Slack: Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=

# Gmail: Desktop OAuth client; the refresh token is filled by "Sign in with Google" on the Setup page
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
